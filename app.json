{
  "expo": {
    "name": "CBA-Agent",
    "slug": "cba-agent-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appIcon.png",
    "scheme": "cbaagentapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/appIcon.png",
      "bundleIdentifier": "com.optisoft.cbaagent",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptiveIconForeground.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/images/adaptiveIconMonochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.optisoft.cbaagent",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/receiptLogo.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true,
          "dark": {
            "image": "./assets/images/receiptLogoDark.png",
            "backgroundColor": "#151B23",
            "resizeMode": "contain"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Allow $(PRODUCT_NAME) to take a photo to attach to a support ticket."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98c07ac7-f2d9-4f05-b631-eb22d6d276d8"
      }
    }
  }
}
